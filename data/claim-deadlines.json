      "name": "South Carolina",
      "rules": [
        {
          "id": "sc-pol-forms",
          "name": "Furnish proof-of-loss forms",
          "rule_text": "The insurer must furnish proof-of-loss forms within 20 days after receiving notice of the claim. If it does not, the insured is treated as having complied with any proof-of-loss requirement.",
          "citation": {
            "label": "S.C. Code §38-59-10",
            "url": "https://www.scstatehouse.gov/code/t38c059.php"
          },
          "verified": true,
          "verified_by": "licensed firm owner",
          "verified_on": "2026-10-12",
          "next_review": "2027-01-12",
          "day_type": "calendar",
          "unit": "days",
          "amount": 20,
          "trigger": "notice_of_claim",
          "is_suit_limitation": false,
          "is_floor_only": false,
          "computes_filing_date": true
        },
        {
          "id": "sc-refusal-after-demand",
          "name": "Refusal to pay after demand",
          "rule_text": "If an insurer refuses to pay a claim within 90 days after a demand, that refusal can trigger an attorney-fee award. This is an attorney-fee trigger, not a payment deadline.",
          "citation": {
            "label": "S.C. Code §38-59-40",
            "url": "https://www.scstatehouse.gov/code/t38c059.php"
          },
          "verified": true,
          "verified_by": "licensed firm owner",
          "verified_on": "2026-10-12",
          "next_review": "2027-01-12",
          "day_type": "calendar",
          "unit": "days",
          "amount": 90,
          "trigger": "later_event",
          "later_event_label": "written demand",
          "is_suit_limitation": false,
          "is_floor_only": false,
          "computes_filing_date": false,
          "notes": [
            "Attorney-fee trigger, not a statutory payment due date."
          ]
        },
        {
          "id": "sc-contract-sol",
          "name": "Contract statute of limitations",
          "rule_text": "The general contract statute of limitations is 3 years. Whether a property policy may shorten that period has not been verified for this tool.",
          "citation": {
            "label": "S.C. Code §15-3-530(1)",
            "url": "https://www.scstatehouse.gov/code/t15c003.php"
          },
          "verified": true,
